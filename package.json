    "postcss": "^8.5.16",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-spinners": "^0.17.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
